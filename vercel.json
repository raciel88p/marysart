{
  "version": 2,
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/client/**,dist/server/**,dist/astro/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|sitemap.xml|robots.txt|rss.xml|.*\\..*).*)",
      "destination": "/api/index.js"
    }
  ]
}
