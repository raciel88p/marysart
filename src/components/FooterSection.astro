---
import categories from '../data/categories.json';
import { locationsData } from '../data/seo/locations.js';
import { animalsData } from '../data/seo/animals.js';
import { stylesData, roomsData } from '../data/seo/styles-rooms.js';
import { occasionsData } from '../data/seo/occasions.js';
import { restorationsData } from '../data/seo/restorations.js';

const mainLocations = Object.keys(locationsData);
const animals = Object.keys(animalsData);
const occasions = Object.keys(occasionsData);
const restorations = Object.keys(restorationsData);
---

<footer class="bg-stone-900 text-stone-300 pt-16 pb-12 border-t border-stone-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Brand & Mission -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-700 to-amber-500 flex items-center justify-center text-white font-serif text-xl font-bold">
            M
          </div>
          <div>
            <span class="font-serif text-2xl font-bold tracking-tight text-white block">Mary's Art</span>
            <span class="text-[10px] uppercase tracking-widest text-amber-400 font-medium">Costa Rica</span>
          </div>
        </div>
        <p class="text-xs text-stone-400 leading-relaxed">
          No vendemos figuras. Creamos emociones, belleza y tranquilidad para llenar tu hogar con la calidez de piezas pintadas 100% a mano.
        </p>
        <div class="pt-2 text-xs text-amber-300 flex items-center gap-2">
          <span>📍 Talleres en Turrialba & San Carlos</span>
        </div>
      </div>

      <!-- Categories Links -->
      <div>
        <h4 class="font-serif text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-stone-800 pb-2">Colecciones</h4>
        <ul class="space-y-2 text-xs">
          {categories.map((cat) => (
            <li>
              <a href={`/catalogo?categoria=${cat.slug}`} class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
                <span class="text-amber-600">›</span> {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Customer Care & Program -->
      <div>
        <h4 class="font-serif text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-stone-800 pb-2">Atención & Beneficios</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/club-vip" class="hover:text-amber-400 transition-colors flex items-center gap-1">👑 Club VIP Mary's Art</a></li>
          <li><a href="/blog" class="hover:text-amber-400 transition-colors">Blog & Guías de Cuidados</a></li>
          <li><a href="/piezas" class="hover:text-amber-400 transition-colors">Catálogo Digital de Piezas</a></li>
          <li><a href="/campanas/navidad" class="hover:text-amber-400 transition-colors">Colección Navideña Especial</a></li>
          <li><a href="/directorio" class="hover:text-amber-400 transition-colors font-semibold text-amber-300">Directorio Maestro SEO</a></li>
        </ul>
      </div>

      <!-- Guarantee & Contact -->
      <div class="space-y-4">
        <h4 class="font-serif text-sm font-bold text-white uppercase tracking-wider mb-2 border-b border-stone-800 pb-2">Garantía Artesanal</h4>
        <div class="bg-stone-800/80 p-4 rounded-xl border border-stone-700/60 space-y-2">
          <p class="text-xs text-stone-300 font-medium flex items-center gap-2">
            <span class="text-amber-400 text-base">🛡️</span> Compra 100% Segura por WhatsApp
          </p>
          <p class="text-[11px] text-stone-400">
            Envíos asegurados por Correos de Costa Rica o encomienda directa a todas las provincias.
          </p>
        </div>
        <a href="https://wa.me/50660367249?text=Hola%20Mary's%20Art" target="_blank" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold py-2.5 px-4 rounded-xl transition-all inline-flex items-center justify-center gap-2">
          WhatsApp +506 6036-7249
        </a>
      </div>

    </div>

    <!-- SITEMAP HTML EXPANDIBLE / ACCESIBLE (Todas las Landing Pages y Páginas Programáticas) -->
    <div class="my-10 pt-8 border-t border-stone-800/80">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
          <h3 class="font-serif text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <span>🗺️</span> Sitemap HTML & Directorio de Landings Mary's Art Costa Rica
          </h3>
          <p class="text-[11px] text-stone-400">
            Mapa de navegación completo para usuarios y motores de búsqueda hacia nuestras páginas de adquisición y colecciones.
          </p>
        </div>
        <a
          href="/directorio"
          class="text-xs font-semibold text-amber-400 hover:text-amber-300 underline"
        >
          Ver Directorio Completo →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-[11px]">
        <!-- Col 1: Landings Principales y Figuras de Yeso -->
        <div class="space-y-4 bg-stone-950/40 p-4 rounded-2xl border border-stone-800/60">
          <div>
            <h4 class="font-bold text-amber-400 uppercase tracking-wider mb-2">Páginas & Landings</h4>
            <ul class="space-y-1 text-stone-400">
              <li><a href="/" class="hover:text-stone-200">Inicio Mary's Art</a></li>
              <li><a href="/catalogo" class="hover:text-stone-200">Catálogo General</a></li>
              <li><a href="/piezas" class="hover:text-stone-200">Catálogo de Piezas & Revistas</a></li>
              <li><a href="/servicios" class="hover:text-stone-200">Servicios de Restauración</a></li>
              <li><a href="/club-vip" class="hover:text-stone-200">Club VIP & Talleres</a></li>
              <li><a href="/marys-arts" class="hover:text-stone-200">Landing Mary's Arts</a></li>
              <li><a href="/campanas/navidad" class="hover:text-stone-200">Campaña Navidad</a></li>
              <li><a href="/campanas/dia-de-la-madre" class="hover:text-stone-200">Campaña Día de la Madre</a></li>
              <li><a href="/directorio" class="hover:text-stone-200 text-amber-300">Directorio Principal</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-amber-400 uppercase tracking-wider mb-2">Figuras de Yeso</h4>
            <ul class="space-y-1 text-stone-400">
              {mainLocations.map((c) => (
                <li>
                  <a href={`/figuras-yeso/${c}`} class="hover:text-stone-200">
                    Yeso en {locationsData[c].cantonName}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Col 2: Figuras de Resina y Clases de Pintura -->
        <div class="space-y-4 bg-stone-950/40 p-4 rounded-2xl border border-stone-800/60">
          <div>
            <h4 class="font-bold text-amber-400 uppercase tracking-wider mb-2">Figuras de Resina</h4>
            <ul class="space-y-1 text-stone-400">
              {mainLocations.map((c) => (
                <li>
                  <a href={`/figuras-resina/${c}`} class="hover:text-stone-200">
                    Resina en {locationsData[c].cantonName}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-amber-400 uppercase tracking-wider mb-2">Talleres de Pintura</h4>
            <p class="text-[10px] text-amber-300/80 mb-1 font-medium">Sedes Presenciales:</p>
            <ul class="space-y-1 text-stone-300 font-semibold">
              <li>
                <a href="/clases-pintura/turrialba" class="hover:text-amber-400">
                  📍 Taller Turrialba (Cartago)
                </a>
              </li>
              <li>
                <a href="/clases-pintura/san-carlos" class="hover:text-amber-400">
                  📍 Taller San Carlos (Alajuela)
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Col 3: Casitas, Villas & Fauna -->
        <div class="space-y-4 bg-stone-950/40 p-4 rounded-2xl border border-stone-800/60">
          <div>
            <div class="flex items-center gap-1.5 mb-2">
              <span class="text-[9px] font-extrabold px-1.5 py-0.2 bg-amber-600 text-white rounded">TOP VENTAS</span>
              <h4 class="font-bold text-amber-400 uppercase tracking-wider">Casitas & Villas</h4>
            </div>
            <ul class="space-y-1 text-stone-400">
              <li>
                <a href="/casitas-villas/villas-navidenas-con-luz-led" class="text-amber-300 font-semibold hover:text-amber-200">
                  ✨ Villas Navideñas con Luz LED
                </a>
              </li>
              <li>
                <a href="/casitas-villas/casitas-rusticas-campesinas-resina" class="hover:text-stone-200">
                  Casitas Campesinas Típicas
                </a>
              </li>
              <li>
                <a href="/casitas-villas/pueblos-miniaturas-resina-coleccionables" class="hover:text-stone-200">
                  Pueblos en Miniatura
                </a>
              </li>
              <li>
                <a href="/casitas-villas/fachadas-coloniales-cuadros-resina" class="hover:text-stone-200">
                  Fachadas de Pared
                </a>
              </li>
              <li>
                <a href="/casitas-resina/cartago" class="hover:text-stone-200">
                  Casitas en Cartago
                </a>
              </li>
              <li>
                <a href="/casitas-resina/san-jose" class="hover:text-stone-200">
                  Casitas en San José
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-amber-400 uppercase tracking-wider mb-2">Fauna & Esculturas</h4>
            <ul class="space-y-1 text-stone-400">
              {['colibri', 'buho', 'tucan', 'jaguar'].map((a) => (
                <li>
                  <a href={`/figura-${a}-resina`} class="hover:text-stone-200">
                    {animalsData[a].name} en Resina
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-amber-400 uppercase tracking-wider mb-2">Regalos por Ocasión</h4>
            <ul class="space-y-1 text-stone-400">
              {occasions.map((o) => (
                <li>
                  <a href={`/regalo-${o}`} class="hover:text-stone-200">
                    {occasionsData[o].name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Col 4: Restauración & Estilos de Decoración -->
        <div class="space-y-4 bg-stone-950/40 p-4 rounded-2xl border border-stone-800/60">
          <div>
            <h4 class="font-bold text-amber-400 uppercase tracking-wider mb-2">Restauración Especializada</h4>
            <ul class="space-y-1 text-stone-400">
              {restorations.map((r) => (
                <li>
                  <a href={`/restauracion/${r}`} class="hover:text-stone-200">
                    {restorationsData[r].name}
                  </a>
                </li>
              ))}
              {['turrialba', 'cartago', 'san-jose', 'san-carlos'].map((c) => (
                <li>
                  <a href={`/restauracion/${c}`} class="hover:text-stone-200">
                    Restauración en {locationsData[c]?.cantonName}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-amber-400 uppercase tracking-wider mb-2">Decoración por Estilo</h4>
            <ul class="space-y-1 text-stone-400">
              {Object.keys(stylesData).map((s) => (
                <li>
                  <a href={`/decoracion-${s}-sala`} class="hover:text-stone-200">
                    Decoración {stylesData[s].name.split('&')[0].trim()} en Sala
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright & Socials -->
    <div class="pt-8 border-t border-stone-800 text-center md:flex md:justify-between md:items-center text-[11px] text-stone-500 space-y-4 md:space-y-0">
      <p>© {new Date().getFullYear()} Mary's Art Costa Rica. Todos los derechos reservados. Pintado a mano con amor.</p>
      <div class="flex justify-center gap-6">
        <a href="https://www.instagram.com/arte_resina_barro/" target="_blank" rel="noopener" class="hover:text-stone-300 transition-colors">Instagram</a>
        <a href="https://www.facebook.com/ResinaArtMary" target="_blank" rel="noopener" class="hover:text-stone-300 transition-colors">Facebook</a>
        <a href="/politicas" class="hover:text-stone-300 transition-colors">Envíos & Devoluciones</a>
      </div>
    </div>
  </div>
</footer>
