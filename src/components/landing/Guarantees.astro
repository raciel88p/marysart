---
const guarantees = [
  {
    title: "Pago Seguro",
    description: "Múltiples métodos de pago confiables (SINPE Móvil, transferencia bancaria y tarjeta).",
    icon: `<svg class="w-8 h-8 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`
  },
  {
    title: "Envíos Nacionales",
    description: "Entregas cuidadosas a cualquier rincón de Costa Rica con embalaje protector contra golpes.",
    icon: `<svg class="w-8 h-8 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path></svg>`
  },
  {
    title: "Atención Personalizada",
    description: "Asesoría cálida e individualizada a través de WhatsApp para guiar la elección perfecta.",
    icon: `<svg class="w-8 h-8 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>`
  },
  {
    title: "Calidad Garantizada",
    description: "Garantía de satisfacción total. Inspeccionamos minuciosamente cada adorno antes del envío.",
    icon: `<svg class="w-8 h-8 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"></path></svg>`
  }
];
---

<section class="py-16 bg-[#FDFBF7] dark:bg-[#181614] border-y border-[#EAE3D2] dark:border-[#332E2A]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {guarantees.map((item) => (
        <div class="flex items-center space-x-4 p-4 rounded-xl bg-[#F5F0E6]/30 dark:bg-[#211E1A]/30">
          <div class="shrink-0 p-3 rounded-xl bg-white dark:bg-[#282420] shadow-xs">
            <Fragment set:html={item.icon} />
          </div>
          <div>
            <h3 class="text-base font-serif font-bold text-[#332E2A] dark:text-[#FDFBF7]">
              {item.title}
            </h3>
            <p class="text-xs text-[#82786E] dark:text-[#A89F93] font-light leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
