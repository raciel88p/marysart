---
const benefits = [
  {
    title: "Pintadas completamente a mano",
    description: "Cada trazo y matiz refleja la dedicación artesanal de manos apasionadas por la belleza.",
    icon: `<svg class="w-7 h-7 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>`
  },
  {
    title: "Cada pieza es única",
    description: "No existen dos piezas idénticas. Tendrás un adorno irrepetible que refleja personalidad.",
    icon: `<svg class="w-7 h-7 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>`
  },
  {
    title: "Regalo perfecto",
    description: "Ideal para sorprender a seres queridos con un detalle cargado de valor sentimental.",
    icon: `<svg class="w-7 h-7 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm0 13C10.832 21 2 13.5 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 5-8.832 12.5-10 13z"></path></svg>`
  },
  {
    title: "Materiales de alta calidad",
    description: "Resina duradera y pigmentos de alta resistencia que conservan su color con el paso de los años.",
    icon: `<svg class="w-7 h-7 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>`
  },
  {
    title: "Producción artesanal",
    description: "Procesos tradicionales que promueven el amor por el arte y el cuidado minucioso.",
    icon: `<svg class="w-7 h-7 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>`
  },
  {
    title: "Hecho con amor",
    description: "Cada adorno nace de la dedicación de nuestra tallerista María para transmitir serenidad.",
    icon: `<svg class="w-7 h-7 text-[#C86D51]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.684a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>`
  }
];
---

<section id="beneficios" class="py-20 bg-[#F5F0E6] dark:bg-[#1E1B18] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-xs uppercase tracking-widest text-[#C86D51] font-semibold">
        Por qué elegir Marys Arts
      </h2>
      <p class="text-3xl sm:text-4xl font-serif font-bold text-[#332E2A] dark:text-[#FDFBF7]">
        La calidez de lo auténticamente hecho a mano
      </p>
      <div class="w-16 h-0.5 bg-[#C86D51] mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {benefits.map(benefit => (
        <div class="p-8 rounded-2xl bg-[#FDFBF7] dark:bg-[#282420] border border-[#EAE3D2] dark:border-[#332E2A] shadow-sm hover:shadow-md hover:border-[#C86D51]/40 transition-all duration-300 group">
          <div class="w-14 h-14 rounded-2xl bg-[#F5F0E6] dark:bg-[#1E1B18] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <Fragment set:html={benefit.icon} />
          </div>
          <h3 class="text-xl font-serif font-bold text-[#332E2A] dark:text-[#FDFBF7] mb-3 group-hover:text-[#C86D51] transition-colors">
            {benefit.title}
          </h3>
          <p class="text-sm text-[#665E55] dark:text-[#C5BCB1] leading-relaxed font-light">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
