---
import HeaderNav from '../components/HeaderNav.astro';
import CartDrawer from '../components/CartDrawer.astro';
import FooterSection from '../components/FooterSection.astro';
import '../index.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object;
}

const {
  title,
  description,
  image = '/images/gallery/IMG-20250212-WA0032.jpg',
  schema
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://marys-art.cr');
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:locale" content="es_CR" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <!-- Schema.org -->
  {schema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  )}

  <script is:inline>
    // Initialize theme based on preference or stored value
    const storedTheme = localStorage.getItem('theme');
    if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-100 font-sans antialiased min-h-screen flex flex-col selection:bg-amber-800 selection:text-white">

  <HeaderNav />

  <main class="flex-1">
    <slot />
  </main>

  <FooterSection />
  <CartDrawer />

  <!-- Fixed WhatsApp Floating CTA button -->
  <a
    href="https://wa.me/50660367249?text=Hola%20Mary's%20Art,%20quisiera%20consultar%20sobre%20las%20piezas%20disponibles"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    class="fixed bottom-6 right-6 z-40 bg-emerald-600 hover:bg-emerald-700 text-white p-3.5 rounded-full shadow-2xl hover:scale-110 transition-transform flex items-center justify-center group"
  >
    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
    <span class="absolute right-full mr-3 bg-stone-900 text-white text-xs font-medium px-3 py-1.5 rounded-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity shadow-md pointer-events-none">
      ¿Consultas? Escríbenos por WhatsApp
    </span>
  </a>

</body>
</html>
