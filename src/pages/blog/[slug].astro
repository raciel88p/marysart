---
import ShopLayout from '../../layouts/ShopLayout.astro';
import posts from '../../data/blog.json';

export function getStaticPaths() {
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/blog');
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": `https://marys-art.cr${post.image}`,
  "author": {
    "@type": "Person",
    "name": post.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Mary's Art Costa Rica"
  },
  "datePublished": post.date
};
---

<ShopLayout
  title={`${post.title} | Blog Mary's Art`}
  description={post.excerpt}
  image={post.image}
  schema={articleSchema}
>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <div class="space-y-4 text-center">
      <span class="text-xs uppercase tracking-widest font-bold text-amber-800 dark:text-amber-400">{post.category}</span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-900 dark:text-stone-100 leading-tight">
        {post.title}
      </h1>
      <div class="text-xs text-stone-500 space-x-3">
        <span>Por {post.author}</span>
        <span>•</span>
        <span>{post.readTime}</span>
      </div>
    </div>

    <img src={post.image} alt={post.title} class="w-full h-[400px] object-cover rounded-3xl my-8 border border-stone-200 dark:border-stone-800 shadow-lg" />

    <div class="prose dark:prose-invert max-w-none text-stone-700 dark:text-stone-300 text-sm sm:text-base leading-relaxed space-y-4">
      <p class="font-medium text-base text-stone-900 dark:text-stone-100 italic">{post.excerpt}</p>
      <p>{post.content}</p>

      <div class="p-6 bg-amber-50 dark:bg-stone-800 rounded-2xl border border-amber-200 dark:border-stone-700 my-8 space-y-3">
        <h3 class="font-serif font-bold text-amber-900 dark:text-amber-300 text-base">¿Quieres personalizar una pieza para tu hogar?</h3>
        <p class="text-xs text-stone-700 dark:text-stone-300">Nuestra artesana María pinta cada figura a mano según tus tonos y colores preferidos.</p>
        <a href="https://wa.me/50660367249?text=Hola%20Mary's%20Art,%20le%C3%AD%20el%20art%C3%ADculo%20del%20blog" target="_blank" class="inline-block bg-amber-800 text-white font-semibold text-xs px-5 py-2.5 rounded-xl">
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </article>
</ShopLayout>
