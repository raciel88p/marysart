---
import ShopLayout from '../../layouts/ShopLayout.astro';
import { servicesData } from '../../components/ServiceDetailPage.jsx';

export function getStaticPaths() {
  return Object.keys(servicesData).map(serviceId => ({
    params: { serviceId },
    props: { service: servicesData[serviceId] }
  }));
}

const { service } = Astro.props;

if (!service) {
  return Astro.redirect('/servicios');
}

const whatsappUrl = `https://wa.me/50660367249?text=${encodeURIComponent(service.whatsappMessage)}`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.title,
  "description": service.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Mary's Art Costa Rica",
    "telephone": "+50660367249"
  }
};
---

<ShopLayout
  title={`${service.title} | Mary's Art Costa Rica`}
  description={service.description}
  schema={serviceSchema}
>
  <div class="bg-gradient-to-b from-stone-900 via-stone-900 to-amber-950 text-stone-100 py-16 sm:py-20 border-b border-stone-800">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-4">
      <nav class="text-xs text-amber-300 flex justify-center items-center gap-2">
        <a href="/" class="hover:underline">Inicio</a>
        <span>/</span>
        <a href="/servicios" class="hover:underline">Servicios</a>
        <span>/</span>
        <span class="text-white font-bold">{service.tag}</span>
      </nav>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold">{service.title}</h1>
      <p class="text-xs sm:text-base text-stone-300">{service.subtitle}</p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Main Service Info -->
    <div class="bg-white dark:bg-stone-900 rounded-3xl p-8 border border-stone-200 dark:border-stone-800 shadow-sm space-y-6">
      <h2 class="font-serif text-2xl font-bold text-stone-900 dark:text-stone-100">Detalles del Servicio</h2>
      <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">{service.description}</p>

      <div class="pt-4 flex flex-col sm:flex-row gap-4">
        <a
          href={whatsappUrl}
          target="_blank"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-6 py-3.5 rounded-xl shadow-md text-center flex items-center justify-center gap-2"
        >
          <span>Cotizar por WhatsApp (+506 6036-7249)</span>
        </a>
        <a
          href="/servicios"
          class="bg-stone-100 dark:bg-stone-800 text-stone-800 dark:text-stone-200 font-semibold text-xs px-6 py-3.5 rounded-xl text-center"
        >
          ← Ver Todos los Servicios
        </a>
      </div>
    </div>

    <!-- Step by Step Process -->
    <div class="bg-stone-50 dark:bg-stone-900 rounded-3xl p-8 border border-stone-200 dark:border-stone-800 space-y-6">
      <h2 class="font-serif text-2xl font-bold text-stone-900 dark:text-stone-100">Proceso de Trabajo</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {service.processSteps.map((step: any) => (
          <div class="bg-white dark:bg-stone-800 p-5 rounded-2xl border border-stone-100 dark:border-stone-700 space-y-1">
            <h3 class="font-serif font-bold text-sm text-amber-900 dark:text-amber-300">{step.title}</h3>
            <p class="text-xs text-stone-600 dark:text-stone-300">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Scope and FAQ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-white dark:bg-stone-900 p-6 rounded-3xl border border-stone-200 dark:border-stone-800 space-y-3">
        <h3 class="font-serif text-lg font-bold text-stone-900 dark:text-stone-100">Tipos de Piezas Aceptadas</h3>
        <ul class="space-y-2 text-xs text-stone-600 dark:text-stone-300">
          {service.materialsHandled.map((mat: string) => (
            <li class="flex items-center gap-2">
              <span class="text-amber-800 dark:text-amber-400 font-bold">•</span> {mat}
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-white dark:bg-stone-900 p-6 rounded-3xl border border-stone-200 dark:border-stone-800 space-y-3">
        <h3 class="font-serif text-lg font-bold text-stone-900 dark:text-stone-100">Preguntas Frecuentes</h3>
        <div class="space-y-3">
          {service.faqs.map((faq: any) => (
            <div>
              <h4 class="text-xs font-bold text-amber-800 dark:text-amber-400">{faq.q}</h4>
              <p class="text-xs text-stone-600 dark:text-stone-300">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</ShopLayout>
