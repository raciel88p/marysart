---
import ShopLayout from '../../layouts/ShopLayout.astro';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

if (!product) {
  return Astro.redirect('/catalogo');
}

const related = products.filter(p => p.id !== product.id && p.categorySlug === product.categorySlug).slice(0, 3);

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "image": product.images.map(img => `https://marys-art.cr${img}`),
  "description": product.story,
  "brand": {
    "@type": "Brand",
    "name": "Mary's Art Costa Rica"
  },
  "offers": {
    "@type": "Offer",
    "url": `https://marys-art.cr/producto/${product.slug}`,
    "priceCurrency": "CRC",
    "price": product.price,
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": product.rating,
    "reviewCount": product.reviewCount
  }
};
---

<ShopLayout
  title={`${product.name} | Mary's Art Costa Rica`}
  description={product.story}
  image={product.images[0]}
  schema={productSchema}
>
  <!-- Breadcrumb -->
  <div class="bg-stone-100 dark:bg-stone-900 border-b border-stone-200 dark:border-stone-800 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-stone-500 flex items-center gap-2">
        <a href="/" class="hover:underline">Inicio</a>
        <span>/</span>
        <a href="/catalogo" class="hover:underline">Catálogo</a>
        <span>/</span>
        <a href={`/catalogo?categoria=${product.categorySlug}`} class="hover:underline">{product.category}</a>
        <span>/</span>
        <span class="text-stone-900 dark:text-stone-200 font-bold truncate">{product.name}</span>
      </nav>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- Product Gallery & Zoom -->
      <div class="lg:col-span-6 space-y-4">
        <div class="relative rounded-3xl overflow-hidden border border-stone-200 dark:border-stone-800 bg-stone-100 dark:bg-stone-900 group">
          <img
            id="main-product-image"
            src={product.images[0]}
            alt={product.name}
            class="w-full h-[450px] sm:h-[520px] object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <span class="absolute top-4 left-4 bg-amber-800 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">
            Pintado 100% a mano
          </span>
        </div>

        {product.images.length > 1 && (
          <div class="flex gap-4">
            {product.images.map((img, idx) => (
              <button
                data-img-target={img}
                class={`w-20 h-20 rounded-xl overflow-hidden border-2 transition-all ${idx === 0 ? 'border-amber-800 shadow-md' : 'border-stone-200 dark:border-stone-700 opacity-70'}`}
              >
                <img src={img} alt={`${product.name} vista ${idx+1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}

        <!-- Emotional Highlights Box -->
        <div class="p-5 bg-amber-50/80 dark:bg-stone-800/80 rounded-2xl border border-amber-200/60 dark:border-stone-700 space-y-2 text-xs">
          <h4 class="font-serif font-bold text-amber-900 dark:text-amber-300 text-sm flex items-center gap-2">
            ✨ Beneficio Emocional
          </h4>
          <p class="text-stone-700 dark:text-stone-300 leading-relaxed">
            {product.emotionalBenefit}
          </p>
        </div>
      </div>

      <!-- Product Meta & Purchase Panel -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-800 dark:text-amber-400 font-bold">{product.category}</span>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 dark:text-stone-100 mt-1 leading-tight">
            {product.name}
          </h1>
          <div class="flex items-center gap-3 mt-3 text-xs">
            <span class="text-amber-600 font-bold flex items-center gap-1">
              ★★★★★ {product.rating}
            </span>
            <span class="text-stone-400">|</span>
            <span class="text-stone-600 dark:text-stone-300">{product.reviewCount} valoraciones de clientes satisfechos</span>
          </div>
        </div>

        <!-- Pricing -->
        <div class="p-4 bg-stone-50 dark:bg-stone-800/60 rounded-2xl border border-stone-200/80 dark:border-stone-700 flex items-center justify-between">
          <div>
            <div class="flex items-baseline gap-2">
              <span class="font-serif text-3xl font-bold text-amber-900 dark:text-amber-400">₡{product.price.toLocaleString('es-CR')}</span>
              <span class="text-sm text-stone-400 line-through">₡{product.originalPrice.toLocaleString('es-CR')}</span>
            </div>
            <p class="text-[11px] text-emerald-700 dark:text-emerald-400 font-medium mt-0.5"> Envío GRATIS en Costa Rica si sumas ₡35.000 o más</p>
          </div>
          <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1.5 rounded-full">En Stock</span>
        </div>

        <!-- Story & Artisan Specs -->
        <div class="space-y-4 border-t border-b border-stone-200 dark:border-stone-800 py-6">
          <div>
            <h3 class="font-serif font-bold text-stone-900 dark:text-stone-100 text-base mb-1">Historia de la Pieza</h3>
            <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">{product.story}</p>
          </div>

          <div class="grid grid-cols-2 gap-4 pt-2 text-xs">
            <div class="bg-stone-100 dark:bg-stone-800/80 p-3 rounded-xl">
              <span class="block text-stone-400 font-medium text-[10px] uppercase">Tiempo de Elaboración</span>
              <span class="font-semibold text-stone-900 dark:text-stone-100">{product.artisanTime}</span>
            </div>
            <div class="bg-stone-100 dark:bg-stone-800/80 p-3 rounded-xl">
              <span class="block text-stone-400 font-medium text-[10px] uppercase">Medidas Aproximadas</span>
              <span class="font-semibold text-stone-900 dark:text-stone-100">{product.dimensions}</span>
            </div>
          </div>

          <div>
            <span class="block text-stone-400 font-medium text-[10px] uppercase">Materiales</span>
            <p class="text-xs text-stone-700 dark:text-stone-300 font-medium">{product.materials}</p>
          </div>
        </div>

        <!-- Order Bumps & CTA Actions -->
        <div class="space-y-4">
          <div class="flex gap-3">
            <button
              id="pdp-add-to-cart"
              data-id={product.id}
              data-name={product.name}
              data-price={product.price}
              data-image={product.images[0]}
              class="flex-1 bg-amber-800 hover:bg-amber-900 text-white font-semibold text-sm py-4 px-6 rounded-2xl shadow-lg hover:shadow-xl transition-all text-center flex items-center justify-center gap-2"
            >
              <span>🛒 Agregar al Carrito Artesanal</span>
            </button>
            <a
              href={`https://wa.me/50660367249?text=Hola%20Mary's%20Art,%20me%20interesa%20comprar%20la%20pieza%20${encodeURIComponent(product.name)}`}
              target="_blank"
              class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm px-5 py-4 rounded-2xl transition-all flex items-center justify-center"
              aria-label="Pedir por WhatsApp"
            >
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            </a>
          </div>

          <div class="text-[11px] text-stone-500 text-center space-x-4">
            <span>🛡️ Garantía de envío seguro</span>
            <span>📍 Taller Turrialba & San Carlos</span>
          </div>
        </div>

      </div>

    </div>

    <!-- Related Products Cross-Sell -->
    {related.length > 0 && (
      <div class="mt-20 pt-10 border-t border-stone-200 dark:border-stone-800">
        <h2 class="font-serif text-2xl font-bold text-stone-900 dark:text-stone-100 mb-6">Piezas que Combinan Perfecto</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {related.map(rel => (
            <div class="bg-white dark:bg-stone-900 rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-800 p-4 space-y-3">
              <img src={rel.images[0]} alt={rel.name} class="w-full h-48 object-cover rounded-xl" />
              <h4 class="font-serif font-bold text-stone-900 dark:text-stone-100 text-sm truncate">{rel.name}</h4>
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-amber-800 dark:text-amber-400">₡{rel.price.toLocaleString('es-CR')}</span>
                <a href={`/producto/${rel.slug}`} class="text-amber-800 dark:text-amber-400 font-semibold hover:underline">Ver Pieza →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- Sticky Mobile CTA Bar -->
  <div class="fixed bottom-0 left-0 right-0 bg-white/95 dark:bg-stone-900/95 backdrop-blur-md border-t border-stone-200 dark:border-stone-800 p-3 lg:hidden z-40 flex items-center justify-between gap-3 shadow-2xl">
    <div>
      <span class="text-[10px] text-stone-500 uppercase block">Precio Especial</span>
      <span class="font-serif font-bold text-amber-900 dark:text-amber-400 text-base">₡{product.price.toLocaleString('es-CR')}</span>
    </div>
    <button
      id="mobile-pdp-add-cart"
      data-id={product.id}
      data-name={product.name}
      data-price={product.price}
      data-image={product.images[0]}
      class="flex-1 bg-amber-800 text-white font-semibold text-xs py-3 rounded-xl shadow-md flex items-center justify-center gap-1"
    >
      🛒 Agregar al Carrito
    </button>
  </div>
</ShopLayout>

<script>
  // Image Thumbnails Handler
  const mainImage = document.getElementById('main-product-image') as HTMLImageElement;
  document.querySelectorAll('[data-img-target]').forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-img-target');
      if (mainImage && src) mainImage.src = src;
    });
  });

  // PDP Cart Addition
  function addToCartHandler(btn: Element) {
    const id = btn.getAttribute('data-id');
    const name = btn.getAttribute('data-name');
    const price = parseFloat(btn.getAttribute('data-price') || '0');
    const image = btn.getAttribute('data-image');

    if (!id || !name) return;

    const cart = JSON.parse(localStorage.getItem('marys_art_cart') || '[]');
    const existing = cart.find((item: any) => item.id === id);

    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({ id, name, price, image, quantity: 1 });
    }

    localStorage.setItem('marys_art_cart', JSON.stringify(cart));
    window.dispatchEvent(new Event('cart-updated'));
    window.dispatchEvent(new Event('open-cart-drawer'));
  }

  const pdpBtn = document.getElementById('pdp-add-to-cart');
  const mobilePdpBtn = document.getElementById('mobile-pdp-add-cart');

  if (pdpBtn) pdpBtn.addEventListener('click', () => addToCartHandler(pdpBtn));
  if (mobilePdpBtn) mobilePdpBtn.addEventListener('click', () => addToCartHandler(mobilePdpBtn));
</script>
