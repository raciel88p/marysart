---
import ShopLayout from '../../layouts/ShopLayout.astro';
import products from '../../data/products.json';
import categories from '../../data/categories.json';

const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('categoria') || '';
const searchQuery = (url.searchParams.get('q') || '').toLowerCase();
const sortBy = url.searchParams.get('sort') || 'featured';

let filteredProducts = products.filter(p => {
  const matchesCat = selectedCategory ? p.categorySlug === selectedCategory : true;
  const matchesSearch = searchQuery
    ? p.name.toLowerCase().includes(searchQuery) || p.story.toLowerCase().includes(searchQuery)
    : true;
  return matchesCat && matchesSearch;
});

if (sortBy === 'price-low') {
  filteredProducts.sort((a, b) => a.price - b.price);
} else if (sortBy === 'price-high') {
  filteredProducts.sort((a, b) => b.price - a.price);
} else if (sortBy === 'rating') {
  filteredProducts.sort((a, b) => b.rating - a.rating);
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://marys-art.cr"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Catálogo",
      "item": "https://marys-art.cr/catalogo"
    }
  ]
};
---

<ShopLayout
  title="Catálogo de Esculturas de Resina Pintadas a Mano | Mary's Art Costa Rica"
  description="Explora nuestra colección completa de piezas religiosas, ángeles, figuras de jardín y colección vintage. Arte 100% hecho a mano en Costa Rica."
  schema={breadcrumbSchema}
>
  <div class="bg-stone-100 dark:bg-stone-900 border-b border-stone-200 dark:border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb Nav -->
      <nav class="text-xs text-stone-500 mb-4 flex items-center gap-2">
        <a href="/" class="hover:underline">Inicio</a>
        <span>/</span>
        <span class="text-stone-900 dark:text-stone-200 font-medium">Catálogo</span>
        {selectedCategory && (
          <>
            <span>/</span>
            <span class="text-amber-800 font-bold uppercase">{selectedCategory}</span>
          </>
        )}
      </nav>

      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 dark:text-stone-100">
        Colección de Arte & Resina
      </h1>
      <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 mt-1 max-w-2xl">
        Figuras pintadas delicadamente con acabados finos para llenar tu hogar de significado y personalidad.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Filter, Search & Sort Bar -->
    <form method="GET" action="/catalogo" class="bg-white dark:bg-stone-900 p-4 sm:p-6 rounded-2xl shadow-sm border border-stone-200/80 dark:border-stone-800 mb-8 grid grid-cols-1 md:grid-cols-12 gap-4 items-center">

      <!-- Category Filter Pills -->
      <div class="md:col-span-5 flex flex-wrap gap-2">
        <a
          href="/catalogo"
          class={`text-xs px-3 py-1.5 rounded-full border transition-colors ${!selectedCategory ? 'bg-amber-800 text-white border-amber-800' : 'bg-stone-50 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border-stone-200 dark:border-stone-700'}`}
        >
          Todas
        </a>
        {categories.map((cat) => (
          <a
            href={`/catalogo?categoria=${cat.slug}${searchQuery ? `&q=${searchQuery}` : ''}`}
            class={`text-xs px-3 py-1.5 rounded-full border transition-colors ${selectedCategory === cat.slug ? 'bg-amber-800 text-white border-amber-800 font-semibold' : 'bg-stone-50 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border-stone-200 dark:border-stone-700'}`}
          >
            {cat.name}
          </a>
        ))}
      </div>

      <!-- Search Input -->
      <div class="md:col-span-4">
        <input
          type="text"
          name="q"
          value={searchQuery}
          placeholder="Buscar por nombre o detalle (ej: Virgen, Ángel)..."
          class="w-full text-xs p-2.5 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 focus:outline-none focus:border-amber-800"
        />
        {selectedCategory && <input type="hidden" name="categoria" value={selectedCategory} />}
      </div>

      <!-- Sort Select -->
      <div class="md:col-span-3">
        <select
          name="sort"
          onchange="this.form.submit()"
          class="w-full text-xs p-2.5 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 focus:outline-none"
        >
          <option value="featured" selected={sortBy === 'featured'}>Destacados</option>
          <option value="price-low" selected={sortBy === 'price-low'}>Precio: Menor a Mayor</option>
          <option value="price-high" selected={sortBy === 'price-high'}>Precio: Mayor a Menor</option>
          <option value="rating" selected={sortBy === 'rating'}>Mejor Valorados</option>
        </select>
      </div>

    </form>

    <!-- Product Grid -->
    {filteredProducts.length === 0 ? (
      <div class="text-center py-16 space-y-3 bg-white dark:bg-stone-900 rounded-3xl border border-stone-200/80 dark:border-stone-800">
        <p class="font-serif text-xl text-stone-800 dark:text-stone-200">No encontramos piezas con estos criterios.</p>
        <p class="text-xs text-stone-500">Prueba ajustando el filtro o busca un término más general.</p>
        <a href="/catalogo" class="inline-block mt-2 text-xs font-semibold text-amber-800 dark:text-amber-400 underline">Reiniciar filtros</a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {filteredProducts.map((prod) => (
          <div class="bg-white dark:bg-stone-900 rounded-2xl overflow-hidden border border-stone-200/80 dark:border-stone-800 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="relative h-64 overflow-hidden">
                <img src={prod.images[0]} alt={prod.name} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                <span class="absolute top-3 right-3 bg-amber-800 text-white text-[10px] font-bold px-2.5 py-1 rounded-full">Pintado a mano</span>
              </div>
              <div class="p-5 space-y-2">
                <div class="flex items-center justify-between text-xs text-stone-500">
                  <span>{prod.category}</span>
                  <span class="text-amber-600 font-bold">★ {prod.rating}</span>
                </div>
                <h3 class="font-serif text-lg font-bold text-stone-900 dark:text-stone-100">
                  <a href={`/producto/${prod.slug}`} class="hover:text-amber-800 dark:hover:text-amber-400">{prod.name}</a>
                </h3>
                <p class="text-xs text-stone-600 dark:text-stone-300 line-clamp-2">{prod.story}</p>
              </div>
            </div>

            <div class="p-5 pt-0 space-y-3">
              <div class="flex items-baseline justify-between border-t border-stone-100 dark:border-stone-800 pt-3">
                <div>
                  <span class="text-lg font-bold text-amber-900 dark:text-amber-400 font-serif">₡{prod.price.toLocaleString('es-CR')}</span>
                  <span class="text-xs text-stone-400 line-through ml-1.5">₡{prod.originalPrice.toLocaleString('es-CR')}</span>
                </div>
                <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-medium">En Stock</span>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <a href={`/producto/${prod.slug}`} class="text-center bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 text-stone-800 dark:text-stone-200 text-xs font-semibold py-2.5 rounded-xl transition-colors">
                  Ver Detalles
                </a>
                <button
                  data-add-cart
                  data-id={prod.id}
                  data-name={prod.name}
                  data-price={prod.price}
                  data-image={prod.images[0]}
                  class="bg-amber-800 hover:bg-amber-900 text-white text-xs font-semibold py-2.5 rounded-xl transition-colors flex items-center justify-center gap-1"
                >
                  🛒 Agregar
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</ShopLayout>

<script>
  document.querySelectorAll('[data-add-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      const price = parseFloat(btn.getAttribute('data-price') || '0');
      const image = btn.getAttribute('data-image');

      if (!id || !name) return;

      const cart = JSON.parse(localStorage.getItem('marys_art_cart') || '[]');
      const existing = cart.find((item: any) => item.id === id);

      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ id, name, price, image, quantity: 1 });
      }

      localStorage.setItem('marys_art_cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));
      window.dispatchEvent(new Event('open-cart-drawer'));
    });
  });
</script>
