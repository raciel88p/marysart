---
import ShopLayout from '../../layouts/ShopLayout.astro';
import ProgrammaticLinking from '../../components/seo/ProgrammaticLinking.astro';
import { restorationsData } from '../../data/seo/restorations.js';
import { locationsData } from '../../data/seo/locations.js';
import { buildRestorationPage } from '../../lib/seo-engine.js';
import { getRelatedLinksForCluster } from '../../lib/internal-linking.js';

export function getStaticPaths() {
  const paths: any[] = [];

  // Especialidades de restauración técnica
  Object.keys(restorationsData).forEach((slug) => {
    paths.push({
      params: { slug },
      props: { slug }
    });
  });

  // Restauración local por cantones
  Object.keys(locationsData).forEach((cantonSlug) => {
    paths.push({
      params: { slug: cantonSlug },
      props: { slug: cantonSlug }
    });
  });

  return paths;
}

const { slug } = Astro.props;
const pageData = buildRestorationPage(slug);
const relatedLinks = getRelatedLinksForCluster(pageData.url, 8);
const whatsappUrl = `https://wa.me/50660367249?text=${encodeURIComponent(pageData.cta.whatsappMessage)}`;
---

<ShopLayout
  title={pageData.metaTitle}
  description={pageData.metaDescription}
  schema={pageData.schema}
>
  <header class="bg-gradient-to-b from-stone-900 via-stone-900 to-amber-950 text-stone-100 py-16 sm:py-20 border-b border-stone-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-4">
      <nav class="text-xs text-amber-300 flex justify-center items-center flex-wrap gap-2">
        {pageData.breadcrumb.map((crumb, idx) => (
          <>
            <a href={crumb.url} class="hover:underline">{crumb.name}</a>
            {idx < pageData.breadcrumb.length - 1 && <span>/</span>}
          </>
        ))}
      </nav>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight">{pageData.h1}</h1>
      <p class="text-xs sm:text-base text-stone-300 max-w-3xl mx-auto">{pageData.heroSummary}</p>

      <div class="pt-4 flex flex-wrap justify-center gap-4">
        <a
          href={whatsappUrl}
          target="_blank"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm px-6 py-3.5 rounded-full shadow-lg transition-transform hover:scale-105 flex items-center gap-2"
        >
          <span>{pageData.cta.buttonText}</span>
        </a>
        <a
          href="/servicios"
          class="bg-amber-800/60 hover:bg-amber-800 text-amber-100 font-semibold text-xs sm:text-sm px-6 py-3.5 rounded-full border border-amber-600/40 transition-colors"
        >
          Ver Todos los Servicios
        </a>
      </div>
    </div>
  </header>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <section class="bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 rounded-3xl p-6 sm:p-8 space-y-3 shadow-xs">
      <div class="flex items-center gap-2 text-amber-900 dark:text-amber-300">
        <span class="text-base font-bold">✨ Diagnóstico Rápido & Metodología Conservadora</span>
      </div>
      <p class="text-xs sm:text-sm text-stone-800 dark:text-stone-200 leading-relaxed font-medium">
        {pageData.quickAnswer}
      </p>
    </section>

    <!-- Case Study Before / After if present -->
    {pageData.beforeAfterCase && (
      <section class="bg-stone-900 text-stone-100 rounded-3xl p-6 sm:p-8 border border-stone-800 shadow-md space-y-4">
        <span class="text-xs uppercase font-bold tracking-widest text-amber-400">Caso de Estudio Real</span>
        <h2 class="font-serif text-xl sm:text-2xl font-bold">{pageData.beforeAfterCase.caseTitle}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
          <div class="bg-stone-800/60 p-4 rounded-2xl border border-stone-700/60 space-y-1">
            <h3 class="text-xs font-bold text-red-400 uppercase tracking-wider">Estado Inicial (Problema)</h3>
            <p class="text-xs text-stone-300">{pageData.beforeAfterCase.problem}</p>
          </div>
          <div class="bg-stone-800/60 p-4 rounded-2xl border border-stone-700/60 space-y-1">
            <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wider">Tratamiento Realizado</h3>
            <p class="text-xs text-stone-300">{pageData.beforeAfterCase.solution}</p>
          </div>
          <div class="bg-stone-800/60 p-4 rounded-2xl border border-stone-700/60 space-y-1">
            <h3 class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Resultado & Protección</h3>
            <p class="text-xs text-stone-300">{pageData.beforeAfterCase.result}</p>
          </div>
        </div>
      </section>
    )}

    <section class="bg-white dark:bg-stone-900 rounded-3xl p-6 sm:p-8 border border-stone-200 dark:border-stone-800 shadow-xs space-y-4">
      <h2 class="font-serif text-xl sm:text-2xl font-bold text-stone-900 dark:text-stone-100">Condiciones Técnicas y Tiempos de Entrega</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm text-stone-700 dark:text-stone-300 border-collapse">
          <tbody>
            {pageData.tableAttributes.map((attr, idx) => (
              <tr class={idx % 2 === 0 ? "bg-stone-50 dark:bg-stone-800/40" : "bg-white dark:bg-stone-900"}>
                <th class="py-3 px-4 font-semibold text-stone-900 dark:text-stone-100 border-b border-stone-100 dark:border-stone-800 w-1/3">{attr.key}</th>
                <td class="py-3 px-4 border-b border-stone-100 dark:border-stone-800">{attr.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="bg-white dark:bg-stone-900 rounded-3xl p-6 sm:p-10 border border-stone-200 dark:border-stone-800 shadow-xs">
      <div set:html={pageData.editorialContentHtml} />
    </section>

    <section class="space-y-6">
      <h2 class="font-serif text-2xl font-bold text-stone-900 dark:text-stone-100 text-center">Familias y Parroquias que Confían en Mary's Art</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pageData.testimonials.map((test) => (
          <div class="bg-white dark:bg-stone-900 p-6 rounded-3xl border border-stone-200 dark:border-stone-800 shadow-xs flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="flex text-amber-500 text-sm">★★★★★</div>
              <p class="text-xs text-stone-600 dark:text-stone-300 italic">"{test.quote}"</p>
            </div>
            <div class="border-t border-stone-100 dark:border-stone-800 pt-3">
              <p class="text-xs font-bold text-stone-900 dark:text-stone-100">{test.author}</p>
              <p class="text-[11px] text-stone-500">{test.location} • {test.serviceOrProduct}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-white dark:bg-stone-900 rounded-3xl p-6 sm:p-8 border border-stone-200 dark:border-stone-800 shadow-xs space-y-6">
      <h2 class="font-serif text-2xl font-bold text-stone-900 dark:text-stone-100">Preguntas Frecuentes sobre Restauración</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pageData.faqs.map((faq) => (
          <div class="bg-stone-50 dark:bg-stone-800/50 p-5 rounded-2xl border border-stone-100 dark:border-stone-700/60 space-y-2">
            <h3 class="text-xs sm:text-sm font-bold text-amber-900 dark:text-amber-300">{faq.question}</h3>
            <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <ProgrammaticLinking
      currentUrl={pageData.url}
      links={relatedLinks}
      title="Otros Servicios & Cobertura Local de Restauración"
      subtitle="Atendemos imágenes sacras, figuras de resina y colecciones en Costa Rica."
    />

    <div class="bg-gradient-to-r from-amber-900 to-stone-900 rounded-3xl p-8 text-center text-white space-y-4 shadow-xl">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold">{pageData.cta.title}</h2>
      <p class="text-xs sm:text-sm text-stone-300 max-w-2xl mx-auto">{pageData.cta.subtitle}</p>
      <div class="pt-2">
        <a
          href={whatsappUrl}
          target="_blank"
          class="inline-block bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm px-8 py-3.5 rounded-full shadow-lg transition-transform hover:scale-105"
        >
          {pageData.cta.buttonText}
        </a>
      </div>
    </div>
  </div>
</ShopLayout>
